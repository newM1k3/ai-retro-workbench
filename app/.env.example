# ===== PUBLIC (safe to prefix VITE_ — ships to the browser bundle) =====
# Local PocketBase dev server. Set to your deployed URL in production.
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# ===== SERVER-ONLY (NEVER prefix with VITE_ — must stay out of the client bundle) =====
# These are read by netlify/functions/execute-card.ts from process.env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ZAI_API_KEY=

# Optional model overrides (defaults shown)
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.4
ZAI_MODEL=glm-5.2

# Mock-first execution: MOCK_AI=true forces mock for every run.
# ALLOW_MOCK_FALLBACK=true → auto-mock when a provider key is missing.
MOCK_AI=false
ALLOW_MOCK_FALLBACK=true
